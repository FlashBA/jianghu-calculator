<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#B8AAA0" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/dialog_accent_dark" />
            <stroke android:width="1dp" android:color="@color/dialog_line" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dialog_accent" />
            <stroke android:width="1dp" android:color="@color/dialog_accent_dark" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
