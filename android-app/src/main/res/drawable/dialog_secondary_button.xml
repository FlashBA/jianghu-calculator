<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#D8CABB" />
            <stroke android:width="1dp" android:color="@color/dialog_line" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dialog_surface" />
            <stroke android:width="1dp" android:color="#9C8975" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
